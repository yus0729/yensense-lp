<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>つくっているもの｜YenSense株式会社</title>
<meta name="description" content="YenSense株式会社のプロダクト。AI英会話スピーキング練習アプリ「Spinglish」、読書メモアプリ「Ocren」を開発・運営しています。">
<meta name="theme-color" content="#ffffff">
<meta name="robots" content="index,follow">
<link rel="canonical" href="https://yensense.com/products.html">

<meta property="og:type" content="website">
<meta property="og:site_name" content="YenSense株式会社">
<meta property="og:url" content="https://yensense.com/products.html">
<meta property="og:title" content="つくっているもの｜YenSense株式会社">
<meta property="og:description" content="AI英会話スピーキング練習アプリ「Spinglish」、読書メモアプリ「Ocren」を開発・運営しています。">
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary">

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%231a1913'/%3E%3Ctext x='32' y='44' font-family='Helvetica,Arial,sans-serif' font-weight='700' font-size='34' fill='%23ffffff' text-anchor='middle'%3EY%3C/text%3E%3C/svg%3E">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500&family=Shippori+Mincho:wght@400;500&display=swap" rel="stylesheet">
<noscript><style>[data-reveal]{opacity:1!important;transform:none!important}</style></noscript>

<style>
:root{
  --paper:#ffffff;
  --ink:#1a1913;
  --ink-soft:rgba(26,25,19,.72);
  --ink-mute:#6b675a;
  --line:#e4e2dd;
  --max:1200px;
  --font-en:"Archivo","Helvetica Neue",Arial,sans-serif;
  --font-min:"Shippori Mincho","Hiragino Mincho ProN","Yu Mincho",serif;
  --font-sans:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Hiragino Kaku Gothic ProN","Yu Gothic",Meiryo,sans-serif;
  --ease:cubic-bezier(.16,1,.3,1);
}
*,*::before,*::after{box-sizing:border-box}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--font-sans);font-size:14px;line-height:2.2;letter-spacing:.05em;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
img{max-width:100%;display:block}
a{color:inherit}
h1,h2,h3{margin:0;font-weight:400}
p{margin:0}
.wrap{width:100%;max-width:var(--max);margin-inline:auto;padding-inline:clamp(20px,4vw,48px)}

/* header */
.hdr{border-bottom:1px solid var(--line)}
.hdr__in{display:flex;align-items:center;justify-content:space-between;height:72px}
.brand{font-family:var(--font-en);font-weight:500;font-size:15px;letter-spacing:-.01em;text-decoration:none}
.nav{display:flex;gap:clamp(20px,3vw,40px)}
.nav a{
  font-family:var(--font-en);font-size:10px;font-weight:500;
  letter-spacing:.2em;text-transform:uppercase;
  text-decoration:none;color:var(--ink);
  transition:opacity .5s var(--ease);
}
.nav a:hover{opacity:.45}
@media(max-width:420px){ .nav{gap:14px} .nav a{letter-spacing:.14em} }

/* section */
.sec .wrap{padding-block:clamp(88px,10vw,140px) clamp(120px,14vw,200px)}
.sec__grid{display:grid;gap:clamp(48px,7vw,72px)}
@media(min-width:900px){
  .sec__grid{grid-template-columns:220px minmax(0,1fr);gap:clamp(40px,6vw,96px)}
  .sec__label{position:sticky;top:48px;align-self:start}
}
.sec__label{
  font-family:var(--font-en);font-weight:400;font-size:10px;
  letter-spacing:.24em;text-transform:uppercase;color:var(--ink-mute);
  font-variant-numeric:tabular-nums;
}
.sec__title{
  font-family:var(--font-min);font-weight:400;
  font-size:clamp(22px,2.8vw,34px);line-height:1.9;letter-spacing:.12em;
  font-feature-settings:"palt";
}
.sec__en{
  margin-top:18px;
  font-family:var(--font-en);font-weight:400;font-size:10px;
  letter-spacing:.2em;text-transform:uppercase;color:var(--ink-mute);
}
.sec__body{margin-top:clamp(40px,6vw,72px)}

[data-reveal]{opacity:0;transform:translateY(16px);transition:opacity 1.4s var(--ease),transform 1.4s var(--ease)}
[data-reveal].in{opacity:1;transform:none;transition-delay:calc(var(--i,0)*150ms)}

/* products */
.plist{border-bottom:1px solid var(--line)}
.prow{
  border-top:1px solid var(--line);
  padding-block:clamp(48px,6vw,80px);
  display:grid;grid-template-columns:64px 1fr 1.2fr;gap:clamp(24px,4vw,56px);
  align-items:start;
}
.prow__no{
  font-family:var(--font-en);font-weight:400;font-size:10px;
  letter-spacing:.24em;color:var(--ink-mute);
  font-variant-numeric:tabular-nums;padding-top:8px;
}
.prow__icon{
  width:56px;height:56px;border-radius:13px;
  border:1px solid var(--line);
  margin-bottom:26px;
}
.prow__name{
  font-family:var(--font-en);font-weight:500;
  font-size:clamp(24px,2.6vw,34px);letter-spacing:-.01em;line-height:1.25;
}
.prow__name small{
  font-family:var(--font-sans);font-weight:400;font-size:11px;letter-spacing:.08em;color:var(--ink-mute);
  display:inline-block;margin-left:10px;
}
.prow__cat{display:block;margin-top:12px;font-size:12px;letter-spacing:.1em;color:var(--ink-soft)}
.prow__tags{
  display:block;margin-top:10px;
  font-family:var(--font-en);font-weight:500;font-size:10px;
  letter-spacing:.18em;text-transform:uppercase;color:var(--ink-mute);
}
.prow__desc{font-size:13px;line-height:2.3;color:var(--ink-soft)}
.prow__links{display:flex;gap:28px;margin-top:26px}
.tlink{
  display:inline-flex;align-items:center;gap:7px;text-decoration:none;
  font-family:var(--font-en);font-size:10px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;
  color:var(--ink);white-space:nowrap;position:relative;padding-bottom:3px;
}
.tlink::after{
  content:"";position:absolute;left:0;bottom:0;height:1px;width:100%;
  background:currentColor;transform:scaleX(0);transform-origin:100% 50%;
  transition:transform .5s var(--ease);
}
.tlink:hover::after{transform:scaleX(1);transform-origin:0 50%}
.tlink .arw{transition:transform .4s var(--ease)}
.tlink:hover .arw{transform:translate(2px,-2px)}
@media(max-width:900px){
  .prow{grid-template-columns:1fr;gap:0}
  .prow__no{padding-top:0;margin-bottom:18px}
  .prow__desc{margin-top:22px}
}

/* footer */
.ftr .wrap{
  border-top:1px solid var(--line);
  padding-block:clamp(56px,8vw,96px) 48px;
  display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;
  font-size:12px;color:var(--ink-mute);letter-spacing:.05em;
}
.ftr a{color:var(--ink-mute);text-decoration:none;transition:color .4s}
.ftr a:hover{color:var(--ink)}
.ftr__links{display:flex;gap:24px;flex-wrap:wrap}
.ftr__links .en{font-family:var(--font-en);font-weight:500;font-size:10px;letter-spacing:.18em;text-transform:uppercase}

/* a11y */
.skip{position:absolute;left:-9999px;top:0;background:var(--ink);color:var(--paper);padding:12px 20px;z-index:200}
.skip:focus{left:0}
:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  [data-reveal]{opacity:1!important;transform:none!important}
}
</style>
</head>
<body>
<a class="skip" href="#main">本文へスキップ</a>

<header class="hdr">
  <div class="wrap hdr__in">
    <a class="brand" href="index.html">YenSense</a>
    <nav class="nav" aria-label="メインナビゲーション">
      <a href="company.html">Company</a>
    </nav>
  </div>
</header>

<main id="main">
  <section class="sec">
    <div class="wrap">
      <div class="sec__grid">
        <span class="sec__label" data-reveal>Products</span>
        <div>
          <h1 class="sec__title" data-reveal>つくっているもの</h1>
          <p class="sec__en" data-reveal lang="en" style="--i:1">What we make</p>
          <div class="sec__body">
            <div class="plist">
              <article class="prow" data-reveal>
                <span class="prow__no">01</span>
                <div>
                  <img class="prow__icon" src="img/spinglish.png" alt="Spinglish アプリアイコン" width="56" height="56" loading="lazy">
                  <h2 class="prow__name">Spinglish</h2>
                  <span class="prow__cat">AI英会話スピーキング練習アプリ</span>
                  <span class="prow__tags">iOS · English · AI</span>
                </div>
                <div>
                  <p class="prow__desc">読めるのに、口から出てこない。その一点を解くためのアプリです。日本語を見て英語で声に出す「瞬間英訳」とシャドーイングを、AIがその場で採点。日常会話からスポーツ・金融まで、興味のある分野の文で、一日数分から続けられます。</p>
                  <div class="prow__links">
                    <a class="tlink" href="https://spinglish.jp/" target="_blank" rel="noopener">Website <span class="arw" aria-hidden="true">↗</span></a>
                    <a class="tlink" href="https://apps.apple.com/app/spinglish/id6761403115" target="_blank" rel="noopener">App Store <span class="arw" aria-hidden="true">↗</span></a>
                  </div>
                </div>
              </article>
              <article class="prow" data-reveal style="--i:1">
                <span class="prow__no">02</span>
                <div>
                  <img class="prow__icon" src="img/ocren.png" alt="Ocren アプリアイコン" width="56" height="56" loading="lazy">
                  <h2 class="prow__name">Ocren <small>ページメモ</small></h2>
                  <span class="prow__cat">読書メモアプリ</span>
                  <span class="prow__tags">iOS · Reading · OCR</span>
                </div>
                <div>
                  <p class="prow__desc">気になった一文に、カメラを向けるだけ。紙の本も電子書籍も、縦書きの日本語も高精度でテキストになり、ページ番号とともに残ります。読み終えたあと、引用としていつでも取り出せる。読書のための小さな記録帳です。</p>
                  <div class="prow__links">
                    <a class="tlink" href="https://apps.apple.com/app/id6767999443" target="_blank" rel="noopener">App Store <span class="arw" aria-hidden="true">↗</span></a>
                  </div>
                </div>
              </article>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="ftr">
  <div class="wrap">
    <p>© 2026 YenSense株式会社</p>
    <div class="ftr__links">
      <a class="en" href="company.html">Company</a>
      <a href="privacy.html">プライバシーポリシー</a>
    </div>
  </div>
</footer>

<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var targets = document.querySelectorAll('[data-reveal]');
  if (reduce || !('IntersectionObserver' in window)) {
    targets.forEach(function(el){ el.classList.add('in'); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {threshold:0.1, rootMargin:'0px 0px -6% 0px'});
    targets.forEach(function(el){ io.observe(el); });
  }
})();
</script>
</body>
</html>
